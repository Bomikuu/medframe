# Generate local secrets with: python3 scripts/setup-local.py
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:56379/0
ENCRYPTION_KEY=
APP_SECRET=
APP_ENV=development
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Optional Google Identity Services Web client ID (public; no client secret required).
# Register WEB_ORIGIN under Authorized JavaScript origins in Google Cloud.
GOOGLE_CLIENT_ID=
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
MAIL_FROM=care@medframe.local
RECOVERY_ENABLED=true
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=http://127.0.0.1:59000
STORAGE_BUCKET=medframe-private
SCANNER_HOST=127.0.0.1
SCANNER_PORT=53310
# DATABASE_URL remains the preserved read-only legacy import source.
# Django defaults to the separate medframe_django database on the same host.
# Optional: DJANGO_DATABASE_URL=postgresql://.../medframe_django
# ./medframe supplies BACKEND_URL and browser WebSocket URLs from its selected API port.
# Optional override: NEXT_PUBLIC_OPERATIONS_WS_URL=wss://your-domain/ws/operations
# Appointment and queue pages remain in manual-refresh mode.

# Temporary Android SMSGate Local Server for patient registration OTP only.
# Same Wi-Fi; copy its local address and credentials. Keep secrets in .env, out of Git.
# HTTP is restricted to private IPs in APP_ENV=development; use HTTPS otherwise.
SMSGATE_OTP_ENABLED=false
SMSGATE_LOCAL_URL=
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
