# Generate local secrets with: python3 scripts/setup-local.py
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:56379/0
ENCRYPTION_KEY=
APP_SECRET=
APP_ENV=development
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
MAIL_FROM=care@medframe.local
RECOVERY_ENABLED=true
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
