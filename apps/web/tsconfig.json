{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-rehearsal/types/**/*.ts",
    ".next-rehearsal/dev/types/**/*.ts",
    ".next-batch2-rehearsal/types/**/*.ts",
    ".next-batch2-rehearsal/dev/types/**/*.ts",
    ".next-batch3-rehearsal/types/**/*.ts",
    ".next-batch3-rehearsal/dev/types/**/*.ts",
    ".next-ui-revamp/types/**/*.ts",
    ".next-ui-revamp/dev/types/**/*.ts",
    ".next-anatomical-dental/types/**/*.ts",
    ".next-anatomical-dental/dev/types/**/*.ts",
    ".next-dental-editor/types/**/*.ts",
    ".next-dental-editor/dev/types/**/*.ts",
    ".next-dental-reference/types/**/*.ts",
    ".next-dental-reference/dev/types/**/*.ts",
    ".next-login-enhancements/types/**/*.ts",
    ".next-login-enhancements/dev/types/**/*.ts",
    ".next-reconstruction/types/**/*.ts",
    ".next-reconstruction/dev/types/**/*.ts",
    ".next-batch4/types/**/*.ts",
    ".next-batch4/dev/types/**/*.ts",
    ".next-batch5/types/**/*.ts",
    ".next-batch5/dev/types/**/*.ts",
    ".next-batch6/types/**/*.ts",
    ".next-batch6/dev/types/**/*.ts",
    ".next-anatomy-reference/types/**/*.ts",
    ".next-anatomy-reference/dev/types/**/*.ts",
    ".next-anatomy-focus/types/**/*.ts",
    ".next-anatomy-focus/dev/types/**/*.ts",
    ".next-selection-focus/types/**/*.ts",
    ".next-selection-focus/dev/types/**/*.ts",
    ".next-clinic-onboarding/types/**/*.ts",
    ".next-clinic-onboarding/dev/types/**/*.ts",
    ".next-station/types/**/*.ts",
    ".next-station/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
