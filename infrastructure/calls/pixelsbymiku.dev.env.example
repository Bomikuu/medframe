# Public domain selected by the user. This is preparation, not an activated deployment.
MEDFRAME_PUBLIC_ORIGIN=https://pixelsbymiku.dev
# Required: globally routable IPv4 of the media server, or its externally mapped address.
MEDFRAME_MEDIA_PUBLIC_IP=
# Existing trusted web certificate/key paths for the Caddy configuration.
MEDFRAME_TLS_CERT=
MEDFRAME_TLS_KEY=
# Optional embedded TURN/TLS. DNS/certificate must also cover this hostname.
MEDFRAME_TURN_DOMAIN=turn.pixelsbymiku.dev
MEDFRAME_TURN_CERT=
MEDFRAME_TURN_KEY=
# Browser signaling uses same-origin /ws/calls; raw LiveKit :7880 stays loopback-only.
